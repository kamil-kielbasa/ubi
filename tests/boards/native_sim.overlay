/ {
	fstab {
		compatible = "zephyr,fstab";
	};
};

&flash0 {
	/* Default native_sim geometry: 8 KB erase pages, 1-byte write granularity.
	 * 16 PEBs × 8 KB = 128 KB partition (14 data + 2 reserved).
	 * For MCU-specific geometries use native_sim_nrf5340.overlay or
	 * native_sim_stm32u5.overlay via -DDTC_OVERLAY_FILE.
	 */
	erase-block-size = <8192>;
	write-block-size = <1>;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		ubi_partition: partition@0 {
			label = "ubi_partition";
			reg = <0x00000000 DT_SIZE_K(128)>;
		};

		ubi_partition_2: partition@20000 {
			label = "ubi_partition_2";
			reg = <0x00020000 DT_SIZE_K(128)>;
		};
	};
};
