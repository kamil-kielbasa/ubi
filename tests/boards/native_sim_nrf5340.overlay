/ {
	fstab {
		compatible = "zephyr,fstab";
	};
};

&flash0 {
	/* nRF5340 geometry: 4 KB erase pages, 4-byte write alignment.
	 * 16 PEBs × 4 KB = 64 KB partition (14 data + 2 reserved).
	 */
	erase-block-size = <4096>;
	write-block-size = <4>;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		ubi_partition: partition@0 {
			label = "ubi_partition";
			reg = <0x00000000 DT_SIZE_K(64)>;
		};
	};
};
