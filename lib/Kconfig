config UBI_ENABLE
	bool "Enable UBI library"
	depends on FLASH && FLASH_MAP && CRC
	help
	  Enable the Unsorted Block Images (UBI) library.
	  UBI provides wear-leveling, bad block management, and
	  multiple logical volumes on raw flash partitions.

if UBI_ENABLE

rsource "Kconfig.plain"
rsource "Kconfig.secure"

choice UBI_MEM_BACKEND
	prompt "UBI memory backend"
	default UBI_MEM_BACKEND_STATIC
	help
	  Select the memory allocation backend for UBI runtime
	  data structures. The static backend uses k_mem_slab
	  pools sized at compile time; the heap backend uses
	  k_malloc / k_free from the global Zephyr heap.

config UBI_MEM_BACKEND_STATIC
	bool "Static (k_mem_slab)"
	help
	  All UBI allocations come from fixed-size slab pools.
	  Provides deterministic RAM budget and isolates UBI
	  from the application heap. Requires setting
	  CONFIG_UBI_MAX_NR_OF_DEVICES and
	  CONFIG_UBI_MAX_NR_OF_DATA_PEBS to match the flash
	  geometry.

config UBI_MEM_BACKEND_HEAP
	bool "Heap (k_malloc)"
	help
	  UBI allocations use the global Zephyr heap.
	  No compile-time pool sizing required, but memory
	  is shared with the rest of the application.

endchoice

config UBI_MAX_NR_OF_DEVICES
	int "Maximum number of concurrent UBI devices"
	default 1
	range 1 4
	help
	  Upper limit on the number of UBI device handles that
	  can exist simultaneously. Multiplies all slab pool
	  sizes when the static backend is selected.

config UBI_MAX_NR_OF_DATA_PEBS
	int "Maximum number of data PEBs per device"
	default 14
	range 1 4096
	help
	  Upper limit on the number of data PEBs (total PEBs
	  minus reserved PEBs) for a single UBI device. Used
	  by the static backend to size the small-item slab
	  pool. Must be >= total_data_peb_count of every flash
	  partition managed by UBI.

module = UBI
module-str = ubi
source "subsys/logging/Kconfig.template.log_config"

config UBI_TEST_API_ENABLE
	bool "Enable internal UBI test API"
	help
	  Expose ubi_device_get_peb_ec() and
	  ubi_device_check_invariants() for test suites.
	  Do not enable in production builds.

config UBI_TEST_MEM_STATS
	bool "Enable UBI memory pool statistics"
	default n
	depends on UBI_TEST_API_ENABLE && UBI_MEM_BACKEND_STATIC
	help
	  When enabled, UBI logs slab pool high-water marks
	  during device deinit for diagnostic purposes.

config UBI_TEST_FAULT_INJECTION
	bool "Enable UBI fault injection hooks"
	depends on UBI_TEST_API_ENABLE
	help
	  Wraps memory allocations with a test-controllable hook
	  that can be configured to fail after N calls. Used for
	  testing transactional safety under allocation failures.
	  Do not enable in production builds.

endif # UBI_ENABLE
